{
    "version": 2,
    "functions": {
        "server.js": {
            "memory": 1024,
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "server.js",
            "headers": {
                "x-vercel-body-parser-size-limit": "50mb"
            }
        }
    ]
}
